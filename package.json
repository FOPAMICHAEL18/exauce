{
  "name": "exauce",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.17.0",
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@noble/hashes": "^2.4.0",
    "@prisma/adapter-neon": "^7.9.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@vinext/cloudflare": "latest",
    "jose": "^6.2.12",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.34.0",
    "pg": "^8.23.0",
    "react": "latest",
    "react-dom": "latest",
    "react-leaflet": "^5.0.0",
    "react-server-dom-webpack": "latest",
    "server-only": "^0.0.1",
    "vinext": "latest",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "latest",
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.63.0",
    "@secretlint/quick-start": "^13.0.5",
    "@tailwindcss/postcss": "latest",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/eslint__js": "^8.42.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "latest",
    "@vitejs/plugin-rsc": "latest",
    "@vitest/coverage-v8": "^5.0.1",
    "audit-ci": "^7.1.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.10.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.5.1",
    "miniflare": "^5.20260820.0-alpha",
    "msw": "^2.15.0",
    "prisma": "^7.9.1",
    "tailwindcss": "latest",
    "tsx": "^4.23.15",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "^5.0.0",
    "vitest-mock-extended": "^5.1.1",
    "workerd": "^1.20260825.1",
    "wrangler": "^4.125.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "deploy": "vinext-cloudflare deploy --config dist/server/wrangler.json",
    "deploy:preview": "vinext-cloudflare deploy --preview --config dist/server/wrangler.json",
    "preview": "npm run build && npm run start --",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv ./worker-configuration.d.ts",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "prepare": "prisma generate && husky",
    "lint": "eslint .",
    "db:seed": "prisma db seed",
    "db:rebuild-views": "tsx scripts/rebuild-views.ts"
  },
  "lint-staged": {
    "*": [
      "npx secretlint"
    ],
    "*.{js,jsx,ts,tsx}": [
      "npx eslint --fix",
      "npx vitest related --run --bail"
    ]
  },
  "prisma": {
    "seed": "tsx --env-file=.dev.vars prisma/seed.ts"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0",
    "mysql2": "^3.23.1",
    "sharp": "^0.35.4",
    "braces": "^3.0.3",
    "fflate": "^0.8.2",
    "undici": "^7.30.0"
  },
  "allowScripts": {
    "@prisma/engines@7.10.0": true,
    "esbuild@0.28.1": true,
    "workerd@1.20261001.1": true,
    "workerd@1.20260820.1": true,
    "msw@2.15.0": true,
    "prisma@7.10.0": true,
    "esbuild@0.28.2": true,
    "workerd@1.20261006.1": true
  }
}
