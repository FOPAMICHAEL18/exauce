// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Admin {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String
  surname   String
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  slug      String   @unique
  product   Product[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id            Int      @id @default(autoincrement())
  title         String   
  slug          String   @unique
  description   String   @db.Text
  price         Decimal  @db.Decimal(10, 2)
  stockStatus   String   @default("disponible")
  categoryId    Int
  views         Int      @default(0)
  category      Category @relation(fields:[categoryId], references: [id], onDelete: Cascade)
  image         Image[]
  review        Review[]
  viewLogs      View[]  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Image {
  id            Int       @id @default(autoincrement())
  url           String    //URL R@
  altText       String?   //Texte alternatif pour le SEO
  order         Int       @default(0) // Ordre d'affichage
  productId     Int
  product       Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model Review {
  id            Int       @id @default(autoincrement())
  author        String    //Nom ou pseudo
  email         String   
  rating        Int      //1 a 5
  comment       String    @db.Text
  status        String    @default("published") // published ou hidden
  productId     Int
  product       Product    @relation(fields: [productId], references: [id])
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model Contact {
  id            Int       @id @default(autoincrement())
  address       String    @db.Text 
  phone         String      
  email         String    
  hours         String?   
  socials       String?
  latitude      Float?
  longitude     Float?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model View {
  id            Int       @id @default(autoincrement())
  sessionId    String  //Identifiant unique du visiteur (generer par le serveur)
  productId     Int    //ID du produit consulter
  product       Product   @relation(fields: [productId], references:[id], onDelete: Cascade)
  createdAt     DateTime  @default(now())

  // Contrainte d'unicite: empeche la meme session de compter deux fois le meme produit 
  @@unique([sessionId, productId])
}